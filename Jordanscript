-- Hosted on a service like GitHub Gist

local function createLuckGui()
    local Players = game:GetService("Players")
    local localPlayer = Players.LocalPlayer
    if not localPlayer then return end

    local ReplicatedStorage = game:GetService("ReplicatedStorage")
    local SetLocalLuckEvent = ReplicatedStorage:WaitForChild("SetLocalLuckEvent")
    local HatchEggEvent = ReplicatedStorage:WaitForChild("HatchEgg") -- Assuming you have this

    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "LuckSetterGUI"
    screenGui.ResetOnSpawn = false
    screenGui.Parent = localPlayer.PlayerGui

    local mainFrame = Instance.new("Frame")
    mainFrame.Size = UDim2.new(0, 200, 0, 100)
    mainFrame.Position = UDim2.new(0.1, 0, 0.1, 0)
    mainFrame.AnchorPoint = Vector2.new(0.5, 0.5)
    mainFrame.BackgroundTransparency = 0.8
    mainFrame.BorderSizePixel = 0
    mainFrame.Parent = screenGui

    local luckLabel = Instance.new("TextLabel")
    luckLabel.Size = UDim2.new(1, 0, 0.3, 0)
    luckLabel.Position = UDim2.new(0, 0, 0, 0)
    luckLabel.Text = "Set Luck Multiplier:"
    luckLabel.TextColor3 = Color3.new(1, 1, 1)
    luckLabel.BackgroundTransparency = 1
    luckLabel.TextScaled = true
    luckLabel.Parent = mainFrame

    local luckTextBox = Instance.new("TextBox")
    luckTextBox.Size = UDim2.new(0.8, 0, 0.3, 0)
    luckTextBox.Position = UDim2.new(0.1, 0, 0.3, 0)
    luckTextBox.PlaceholderText = "Enter Luck (e.g., 2)"
    luckTextBox.Text = "1" -- Default luck
    luckTextBox.Parent = mainFrame

    local hatchButton = Instance.new("TextButton")
    hatchButton.Size = UDim2.new(0.8, 0, 0.3, 0)
    hatchButton.Position = UDim2.new(0.1, 0, 0.65, 0)
    hatchButton.Text = "Hatch Egg (with set luck)"
    hatchButton.TextColor3 = Color3.new(1, 1, 1)
    hatchButton.BackgroundColor3 = Color3.new(0.4, 0.6, 1)
    hatchButton.BorderSizePixel = 0
    hatchButton.Parent = mainFrame

    hatchButton.MouseButton1Click:Connect(function()
        local luckValue = tonumber(luckTextBox.Text) or 1
        SetLocalLuckEvent:FireServer(luckValue)
        HatchEggEvent:FireServer() -- Assuming your normal hatch event
    end)

    local closeButton = Instance.new("TextButton")
    closeButton.Size = UDim2.new(0.2, 0, 0.2, 0)
    closeButton.Position = UDim2.new(0.8, 0, 0, 0)
    closeButton.Text = "X"
    closeButton.TextColor3 = Color3.new(1, 0, 0)
    closeButton.BackgroundColor3 = Color3.new(0.9, 0.9, 0.9)
    closeButton.BorderSizePixel = 0
    closeButton.Parent = mainFrame
    closeButton.MouseButton1Click:Connect(function()
        screenGui:Destroy()
    end)
end

return createLuckGui()
